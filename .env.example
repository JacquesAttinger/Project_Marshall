# Copy to .env.
# MARSHALL_LINEAR_API_KEY, not LINEAR_API_KEY: Bun keeps an exported shell variable over .env,
# and a shell that exports the Hemut LINEAR_API_KEY would silently point Marshall at the wrong workspace.
# Create the key in the ChessBuddy workspace: Settings -> Security & access -> Personal API keys.
MARSHALL_LINEAR_API_KEY=
# Optional until step 09.
NTFY_TOPIC_PREFIX=
