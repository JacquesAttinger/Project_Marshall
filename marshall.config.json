// Last edited: 2026-09-22 12:44 CDT
// Marshall's settings. Comments are allowed here (JSONC); secrets go in .env, not in this file.
// The daemon reads this once at start: after a change, `marshall stop && marshall start`.
{
  // --- Where the work comes from and where it lands ---
  // Linear workspace slug. The Linear key in .env must belong to it, or Marshall refuses to run.
  "workspace": "todo-timer",
  // The Linear team whose Todo issues (assigned to the key's user) are picked up. Todo_Timer (TOD).
  "teamId": "f81fe804-8950-4943-a951-6c69a9b3208e",
  // The git repo the agents edit. Each issue gets its own worktree next to it.
  "repoPath": "~/code/TODO_TIMER",
  // The branch every PR targets and every worktree starts from.
  "baseBranch": "master",

  // --- How many agents, and how often they may start (the Max plan budget) ---
  // Issues worked on at the same time. One slot, one worktree, one Compose stack each. Max 3.
  "maxAgents": 3,
  // New issue starts allowed per calendar day.
  "dailyStartCap": 10,
  // New issue starts allowed inside any rolling window of `windowHours` hours.
  "windowStartCap": 10,
  // Length of that rolling window, in hours.
  "windowHours": 3,
  // How often the daemon polls Linear and checks on its agents, in seconds.
  "pollSeconds": 45,

  // --- When to give up ---
  // An agent with no activity for this many minutes counts as stalled and is resumed. Activity is
  // a transcript write or a hook event, and a single long gate command (pytest, pnpm build, a CI
  // watch) writes neither while it runs, so this must exceed the longest such command.
  "stallMinutes": 15,
  // Total wall clock one issue may take, from claim to hand-off. A bounce restarts it.
  "issueTimeoutHours": 3,
  // Code -> review -> fix rounds the implementer may run before it gives up (Blocked).
  "maxFixCycles": 4,
  // Times a human may send an issue back (comment + move to Todo) before it is parked.
  "maxBounces": 3,
  // Times a crashed or stalled agent is restarted before the issue is released.
  "maxResumes": 2,
  // Planner wall clock, in minutes, inside the issue clock.
  "planMinutes": 20,
  // Hand-off writer wall clock, in minutes. It is read-only, so it should finish well under this.
  "handoffMinutes": 10,
  // After a rate limit with no readable reset time: wait this long, then probe again.
  "rateLimitProbeMinutes": 30,
  // File the implementer's "out of scope found" items as Linear issues at hand-off. Off: they
  // are only listed in the hand-off package. Off since the dry run flooded the backlog.
  "fileFollowUps": false,

  // --- Which Claude model runs which phase (values go straight to `--model`) ---
  "models": {
    // Sorts each issue into simple or complex before planning. Cheap and fast.
    "classifier": "haiku",
    // Writes the plan for simple issues.
    "planSimple": "opus",
    // Writes the plan for complex issues.
    "planComplex": "fable",
    // Writes the hand-off package. Falls back to planSimple when unset.
    "handoff": "opus",
    // Implements the plan and resolves rebase conflicts. Falls back to opus when unset.
    "implement": "opus"
  },

  // --- Ports, so two agents' Compose stacks do not collide ---
  // Host ports the target repo's docker-compose.yml reads from env, keyed by the env var name.
  // Slot N gets base + N * portOffsetPerSlot: with { "POSTGRES_HOST_PORT": 5432 }, slot 0 -> 5432,
  // slot 1 -> 5532, and so on. Empty: TODO_TIMER has no Compose file yet.
  "services": {},
  "portOffsetPerSlot": 100
}
